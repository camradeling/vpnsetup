[Unit]
Description=Shadowsocks-libev Local SOCKS Client
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=shadowsocks
Group=shadowsocks
ExecStart=/usr/bin/ss-local -c /etc/shadowsocks-libev/client.json -u
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
